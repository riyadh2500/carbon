  <!-- ═══ SCROLL REVEAL ════════════════════════════════════════ -->
  <script>
  (function(){
    function revealAll(selector){
      document.querySelectorAll(selector).forEach(function(el, i){
        el.style.animationDelay = (i * 80) + 'ms';
        el.classList.add('visible');
      });
    }

    // Observe elements — reveal as they scroll into view
    function observe(selector){
      var io = new IntersectionObserver(function(entries){
        entries.forEach(function(e){
          if(e.isIntersecting){
            e.target.classList.add('visible');
            io.unobserve(e.target);
          }
        });
      }, { threshold: 0, rootMargin: '0px 0px -60px 0px' });
      document.querySelectorAll(selector).forEach(function(el){ io.observe(el); });
    }

    observe('.hiw-step-reveal');
    observe('.feat-card-reveal');

    // Nav clicks: immediately scroll then reveal
    document.querySelectorAll('a[href="#features"]').forEach(function(a){
      a.addEventListener('click', function(){
        setTimeout(function(){ revealAll('.feat-card-reveal'); }, 500);
      });
    });
    document.querySelectorAll('a[href="#how-it-works"]').forEach(function(a){
      a.addEventListener('click', function(){
        setTimeout(function(){ revealAll('.hiw-step-reveal'); }, 500);
      });
    });
  })();
  </script>

  <!-- ═══ BACKGROUND CANVAS ANIMATION ══════════════════════════ -->
  <script>
  (function(){
    const canvas = document.getElementById('bgCanvas');
    const ctx = canvas.getContext('2d');
    let W, H, lines = [], nodes = [], particles = [];

    function resize(){
      W = canvas.width  = window.innerWidth;
      H = canvas.height = window.innerHeight * 3;
    }

    // Grid lines
    function initGrid(){
      lines = [];
      const spacing = 80;
      // Vertical
      for(let x = 0; x <= W; x += spacing)
        lines.push({x1:x,y1:0,x2:x,y2:H,horiz:false});
      // Horizontal
      for(let y = 0; y <= H; y += spacing)
        lines.push({x1:0,y1:y,x2:W,y2:y,horiz:true});
    }

    // Floating network nodes
    function initNodes(){
      nodes = [];
      for(let i = 0; i < 18; i++){
        nodes.push({
          x: Math.random() * W,
          y: Math.random() * window.innerHeight,
          r: Math.random() * 2.5 + 1,
          vx: (Math.random() - 0.5) * 0.4,
          vy: (Math.random() - 0.5) * 0.4,
          opacity: Math.random() * 0.5 + 0.2,
          pulse: Math.random() * Math.PI * 2
        });
      }
    }

    // Floating particles
    function initParticles(){
      particles = [];
      for(let i = 0; i < 40; i++){
        particles.push({
          x: Math.random() * W,
          y: Math.random() * window.innerHeight,
          r: Math.random() * 1.5 + 0.3,
          vy: -(Math.random() * 0.6 + 0.1),
          vx: (Math.random() - 0.5) * 0.2,
          opacity: Math.random() * 0.4 + 0.1,
          life: Math.random()
        });
      }
    }

    let tick = 0;
    function draw(){
      ctx.clearRect(0, 0, W, H);

      // ── Grid ─────────────────────────────────────────
      lines.forEach(l => {
        const prog = (tick * 0.003 + (l.horiz ? l.y1 : l.x1) * 0.002) % (Math.PI * 2);
        const alpha = 0.025 + Math.sin(prog) * 0.015;
        ctx.strokeStyle = `rgba(170,255,0,${alpha})`;
        ctx.lineWidth = 0.5;
        ctx.beginPath();
        ctx.moveTo(l.x1, l.y1);
        ctx.lineTo(l.x2, l.y2);
        ctx.stroke();
      });

      // ── Grid intersection glow dots ──────────────────
      const spacing = 80;
      for(let x = 0; x <= W; x += spacing){
        for(let y = 0; y <= Math.min(H, window.innerHeight); y += spacing){
          const phase = (tick * 0.01 + x * 0.05 + y * 0.05) % (Math.PI * 2);
          const a = Math.max(0, Math.sin(phase) * 0.18);
          if(a > 0.02){
            ctx.beginPath();
            ctx.arc(x, y, 1.2, 0, Math.PI * 2);
            ctx.fillStyle = `rgba(170,255,0,${a})`;
            ctx.fill();
          }
        }
      }

      // ── Network nodes + connections ──────────────────
      nodes.forEach(n => {
        n.x += n.vx; n.y += n.vy;
        n.pulse += 0.02;
        if(n.x < 0 || n.x > W) n.vx *= -1;
        if(n.y < 0 || n.y > window.innerHeight) n.vy *= -1;
        const a = n.opacity * (0.7 + Math.sin(n.pulse) * 0.3);
        ctx.beginPath();
        ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(170,255,0,${a})`;
        ctx.fill();
        // Outer ring
        ctx.beginPath();
        ctx.arc(n.x, n.y, n.r + 3 + Math.sin(n.pulse) * 2, 0, Math.PI * 2);
        ctx.strokeStyle = `rgba(170,255,0,${a * 0.3})`;
        ctx.lineWidth = 0.5;
        ctx.stroke();
      });

      // Draw connections between close nodes
      for(let i = 0; i < nodes.length; i++){
        for(let j = i+1; j < nodes.length; j++){
          const dx = nodes[i].x - nodes[j].x;
          const dy = nodes[i].y - nodes[j].y;
          const dist = Math.sqrt(dx*dx + dy*dy);
          if(dist < 160){
            const a = (1 - dist/160) * 0.12;
            ctx.beginPath();
            ctx.moveTo(nodes[i].x, nodes[i].y);
            ctx.lineTo(nodes[j].x, nodes[j].y);
            ctx.strokeStyle = `rgba(170,255,0,${a})`;
            ctx.lineWidth = 0.5;
            ctx.stroke();
          }
        }
      }

      // ── Rising particles ─────────────────────────────
      particles.forEach(p => {
        p.y += p.vy; p.x += p.vx; p.life += 0.003;
        if(p.y < -10){ p.y = window.innerHeight + 10; p.x = Math.random() * W; }
        const a = p.opacity * Math.sin(p.life * Math.PI);
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(170,255,0,${Math.max(0,a)})`;
        ctx.fill();
      });

      tick++;
      requestAnimationFrame(draw);
    }

    function init(){
      resize();
      initGrid();
      initNodes();
      initParticles();
      draw();
    }

    window.addEventListener('resize', () => { resize(); initGrid(); });
    init();
  })();
  </script>

