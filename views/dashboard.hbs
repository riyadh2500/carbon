<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Carbon — {{page}}</title>
  <link rel="stylesheet" href="/css/main.css"/>
  <link rel="stylesheet" href="/css/dashboard.css"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet"/>
</head>
<body class="dash-body">

  <!-- ═══ SIDEBAR ═══════════════════════════════════════════════ -->
  <aside class="sidebar">
    <div class="sb-brand">
      <img src="/assets/carbon-logo.svg" width="28" height="28" alt="Carbon Logo"/>
      <span>carbon</span>
    </div>

    <nav class="sb-nav">
      <a href="/dashboard/overview"       class="sb-link {{#if (eq page 'overview')}}sb-active{{/if}}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
        Overview
      </a>
      <a href="/dashboard/api-connections" class="sb-link {{#if (eq page 'api-connections')}}sb-active{{/if}}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
        API Connections
      </a>
      <a href="/dashboard/policy-builder"  class="sb-link {{#if (eq page 'policy-builder')}}sb-active{{/if}}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 20h9M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
        Policy Builder
      </a>
      <a href="/dashboard/ai-playground"   class="sb-link {{#if (eq page 'ai-playground')}}sb-active{{/if}}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/></svg>
        AI Playground
      </a>
      <a href="/dashboard/request-logs"    class="sb-link {{#if (eq page 'request-logs')}}sb-active{{/if}}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        Request Logs
      </a>
      <a href="/dashboard/settings"        class="sb-link {{#if (eq page 'settings')}}sb-active{{/if}}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        Settings
      </a>
    </nav>

    <div class="sb-footer">
      <!-- Sidebar profile dropdown -->
      <div class="sb-profile-wrap" id="sb-profile">
        <div class="sb-user" id="sb-user-btn">
          <div class="sb-avatar">{{user.initials}}</div>
          <div class="sb-user-info">
            <span class="sb-user-name">{{user.name}}</span>
            <span class="sb-user-email">{{user.email}}</span>
          </div>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        </div>
        <div class="profile-dropdown profile-dropdown-up" id="sb-dropdown">
          <div class="pd-header">
            <div class="pd-avatar">{{user.initials}}</div>
            <div class="pd-info">
              <span class="pd-name">{{user.name}}</span>
              <span class="pd-email">{{user.email}}</span>
            </div>
          </div>
          <div class="pd-divider"></div>
          <a href="/dashboard/settings" class="pd-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
            Profile
          </a>
          <a href="/dashboard/settings" class="pd-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
            Settings
          </a>
          <div class="pd-divider"></div>
          <button class="pd-item pd-signout">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            Sign Out
          </button>
        </div>
      </div>
    </div>
  </aside>

  <!-- ═══ MAIN ═══════════════════════════════════════════════════ -->
  <main class="dash-main">

    <!-- TOP BAR -->
    <header class="topbar">
      <div class="topbar-search">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4-4"/></svg>
        <input type="text" placeholder="Search..." id="global-search"/>
      </div>
      <div class="topbar-right">
        <button class="tb-notif" id="notif-btn" aria-label="Notifications">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
          <span class="notif-badge">3</span>
        </button>
        <!-- Topbar profile dropdown -->
        <div class="tb-profile" id="tb-profile">
          <div class="tb-avatar" id="tb-avatar-btn">{{user.initials}}</div>
          <div class="profile-dropdown" id="tb-dropdown">
            <div class="pd-header">
              <div class="pd-avatar">{{user.initials}}</div>
              <div class="pd-info">
                <span class="pd-name">{{user.name}}</span>
                <span class="pd-email">{{user.email}}</span>
              </div>
            </div>
            <div class="pd-divider"></div>
            <a href="/dashboard/settings" class="pd-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
              Profile
            </a>
            <a href="/dashboard/settings" class="pd-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
              Settings
            </a>
            <a href="/dashboard/api-connections" class="pd-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
              API Connections
            </a>
            <div class="pd-divider"></div>
            <button class="pd-item pd-signout" id="signout-btn">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
              Sign Out
            </button>
          </div>
        </div>
      </div>
    </header>

    <!-- PAGE AREA -->
    <div class="page-area">

      {{!-- ═══ OVERVIEW ═══════════════════════════════════════════ --}}
      {{#if (eq page 'overview')}}
      <div class="page-header">
        <h1>Overview</h1>
        <p>Your AI workspace at a glance</p>
      </div>

      <!-- 4 stat cards matching reference exactly -->
      <div class="stats-row">
        <div class="stat-card">
          <div class="stat-top">
            <span class="stat-label">Connected APIs</span>
            <div class="stat-icon stat-icon-green">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#aaff00" stroke-width="2.5" stroke-linecap="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
            </div>
          </div>
          <div class="stat-value">{{stats.connectedApis}} <span class="stat-frac">/ {{stats.totalApis}}</span></div>
          <div class="stat-sub stat-sub-green">{{stats.totalApis}} more available</div>
        </div>
        <div class="stat-card">
          <div class="stat-top">
            <span class="stat-label">Active Policies</span>
            <div class="stat-icon stat-icon-green">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#aaff00" stroke-width="2.5" stroke-linecap="round"><path d="M12 2L4 6v6c0 5.1 3.4 9.9 8 11.2C16.6 21.9 20 17.1 20 12V6z"/></svg>
            </div>
          </div>
          <div class="stat-value">{{stats.activePolicies}}</div>
          <div class="stat-sub stat-sub-yellow">{{stats.pendingPolicies}} pending review</div>
        </div>
        <div class="stat-card">
          <div class="stat-top">
            <span class="stat-label">Total Requests</span>
            <div class="stat-icon stat-icon-green">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#aaff00" stroke-width="2.5" stroke-linecap="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            </div>
          </div>
          <div class="stat-value stat-large">{{stats.totalRequests}}</div>
          <div class="stat-sub">Last 24 hours</div>
        </div>
        <div class="stat-card">
          <div class="stat-top">
            <span class="stat-label">Blocked Requests</span>
            <div class="stat-icon stat-icon-red">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#ff4444" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
            </div>
          </div>
          <div class="stat-value">{{stats.blockedRequests}}</div>
          <div class="stat-sub stat-sub-red">1.8% of total</div>
        </div>
      </div>

      <!-- Chart + Recent Activity side by side -->
      <div class="ov-grid">
        <div class="card">
          <div class="card-hdr">
            <span class="card-title">API Requests</span>
            <span class="card-meta">Last 24 hours ↓</span>
          </div>
          <div class="chart-wrap">
            <div class="chart-ylabels">
              <span>50</span><span>40</span><span>30</span><span>20</span><span>10</span>
            </div>
            <div class="chart-body">
              <svg class="chart-svg" viewBox="0 0 560 130" preserveAspectRatio="none">
                <defs>
                  <linearGradient id="cg" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#aaff00" stop-opacity="0.25"/>
                    <stop offset="100%" stop-color="#aaff00" stop-opacity="0"/>
                  </linearGradient>
                </defs>
                <!-- Grid lines -->
                <line x1="0" y1="26" x2="560" y2="26" stroke="#1e1e1e" stroke-width="1"/>
                <line x1="0" y1="52" x2="560" y2="52" stroke="#1e1e1e" stroke-width="1"/>
                <line x1="0" y1="78" x2="560" y2="78" stroke="#1e1e1e" stroke-width="1"/>
                <line x1="0" y1="104" x2="560" y2="104" stroke="#1e1e1e" stroke-width="1"/>
                <!-- Area fill -->
                <path d="M0,110 C30,108 60,95 100,78 C140,60 170,40 210,50 C250,60 280,28 320,34 C360,40 400,55 440,44 C480,34 520,46 560,36 L560,130 L0,130 Z" fill="url(#cg)"/>
                <!-- Line -->
                <path d="M0,110 C30,108 60,95 100,78 C140,60 170,40 210,50 C250,60 280,28 320,34 C360,40 400,55 440,44 C480,34 520,46 560,36" fill="none" stroke="#aaff00" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                <!-- Peak dots -->
                <circle cx="210" cy="50" r="4" fill="#aaff00"/>
                <circle cx="320" cy="34" r="4" fill="#aaff00"/>
                <circle cx="440" cy="44" r="4" fill="#aaff00"/>
              </svg>
            </div>
          </div>
          <div class="chart-xlabels">
            <span>12 AM</span><span>6 AM</span><span>12 PM</span><span>6 PM</span>
          </div>
        </div>

        <!-- Recent Activity panel -->
        <div class="card">
          <div class="card-hdr">
            <span class="card-title">Recent Activity</span>
          </div>
          <div class="activity-list">
            <div class="act-item">
              <div class="act-dot allowed">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
              </div>
              <div class="act-info">
                <p>Bitcoin price request allowed</p>
                <span>CoinBase API</span>
              </div>
              <span class="act-time">2 min ago</span>
            </div>
            <div class="act-item">
              <div class="act-dot blocked">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              </div>
              <div class="act-info">
                <p>Solana price request blocked</p>
                <span>CoinBase API</span>
              </div>
              <span class="act-time">8 min ago</span>
            </div>
            <div class="act-item">
              <div class="act-dot blocked">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              </div>
              <div class="act-info">
                <p>SMS request blocked</p>
                <span>SMS API</span>
              </div>
              <span class="act-time">16 min ago</span>
            </div>
            <div class="act-item">
              <div class="act-dot allowed">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
              </div>
              <div class="act-info">
                <p>Policy activated</p>
                <span>Grok API</span>
              </div>
              <span class="act-time">20 min ago</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Connected APIs -->
      <div class="section-title-row">
        <span class="section-title">Connected APIs</span>
      </div>
      <div class="api-cards-row">
        {{#each connectedApis}}
        <div class="api-thumb-card">
          <div class="api-thumb-icon api-icon-{{icon}}">
            {{#if (eq icon 'grok')}}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#aaff00" stroke-width="2" stroke-linecap="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>{{/if}}
            {{#if (eq icon 'coinbase')}}<svg width="22" height="22" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" fill="#1652F0"/><path d="M12 6.5C8.96 6.5 6.5 8.96 6.5 12s2.46 5.5 5.5 5.5 5.5-2.46 5.5-5.5S15.04 6.5 12 6.5zm0 8c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" fill="white"/></svg>{{/if}}
            {{#if (eq icon 'sms')}}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#4A90E2" stroke-width="2" stroke-linecap="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>{{/if}}
            {{#if (eq icon 'custom')}}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#aaff00" stroke-width="2" stroke-linecap="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>{{/if}}
          </div>
          <div class="api-thumb-name">{{name}}</div>
          <div class="api-thumb-type">{{category}}</div>
          <div class="status-dot-row"><span class="sdot sdot-on"></span> Connected</div>
          <a href="/dashboard/api-connections" class="btn-sm-outline">Manage</a>
        </div>
        {{else}}
        <div style="padding:24px;color:var(--txt3);font-size:13px;display:flex;align-items:center;gap:10px">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="rgba(170,255,0,.3)" stroke-width="2" stroke-linecap="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          No APIs connected yet.
        </div>
        {{/each}}
        <!-- Add API -->
        <a href="/dashboard/api-connections" class="api-thumb-card api-add-card">
          <div class="api-add-icon">+</div>
          <span>Add API</span>
          <span class="api-add-sub">Connect a new service</span>
        </a>
      </div>
      {{/if}}

      {{!-- ═══ API CONNECTIONS ════════════════════════════════════ --}}
      {{#if (eq page 'api-connections')}}
      <div class="page-header-row">
        <div>
          <h1>API Connections</h1>
          <p>Manage your API integrations and credentials</p>
        </div>
        <button class="btn-primary" id="add-api-btn">+ Add API</button>
      </div>

      <div class="toolbar">
        <div class="search-box">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4-4"/></svg>
          <input type="text" placeholder="Search APIs..." id="api-search"/>
        </div>
      </div>

      <div class="tab-bar" id="api-tabs">
        <button class="tab-pill tab-active" data-filter="all">All ({{apis.length}})</button>
        <button class="tab-pill" data-filter="connected">Connected ({{stats.connectedApis}})</button>
        <button class="tab-pill" data-filter="disconnected">Disconnected (0)</button>
      </div>

      <div class="api-rows" id="api-list">
        {{#each apis}}
        <div class="api-row" data-status="{{status}}" data-name="{{name}}" data-id="{{id}}" data-cat="{{category}}" data-url="{{baseUrl}}" data-keyhint="{{keyHint}}">
          <div class="api-row-icon api-icon-{{icon}}">
            {{#if (eq icon 'grok')}}<svg width="20" height="20" viewBox="0 0 24 24" fill="#aaff00"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"/></svg>{{/if}}
            {{#if (eq icon 'coinbase')}}<svg width="20" height="20" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" fill="#1652F0"/><path d="M12 6.5C8.96 6.5 6.5 8.96 6.5 12s2.46 5.5 5.5 5.5 5.5-2.46 5.5-5.5S15.04 6.5 12 6.5zm0 8c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" fill="white"/></svg>{{/if}}
            {{#if (eq icon 'sms')}}<svg width="20" height="20" viewBox="0 0 24 24" fill="#4A90E2"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-2 12H6v-2h12v2zm0-3H6V9h12v2zm0-3H6V6h12v2z"/></svg>{{/if}}
            {{#if (eq icon 'openai')}}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#888" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>{{/if}}
            {{#if (eq icon 'github')}}<svg width="20" height="20" viewBox="0 0 24 24" fill="#888"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.604-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.464-1.11-1.464-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0 1 12 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.161 22 16.416 22 12c0-5.523-4.477-10-10-10z"/></svg>{{/if}}
            {{#if (eq icon 'custom')}}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#aaff00" stroke-width="2" stroke-linecap="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>{{/if}}
          </div>
          <div class="api-row-info">
            <div class="api-row-cat">{{category}}</div>
            <div class="api-row-name">{{name}}</div>
            <div class="api-row-desc">{{desc}}</div>
          </div>
          <div class="api-row-actions">
            {{#if (eq status 'connected')}}
            <span class="status-pill s-connected"><span></span>Connected</span>
            <button class="btn-manage" data-id="{{id}}" data-name="{{name}}">Manage</button>
            {{else if (eq status 'disconnected')}}
            <span class="status-pill s-disconnected"><span></span>Disconnected</span>
            <button class="btn-manage" data-id="{{id}}" data-name="{{name}}">Manage</button>
            {{else}}
            <span class="status-pill" style="background:rgba(255,204,0,.1);color:#ffcc00"><span style="background:#ffcc00"></span>Coming Soon</span>
            <button class="btn-learn">Learn more</button>
            {{/if}}
          </div>
        </div>
        {{/each}}
        {{#unless apis}}
        <div style="text-align:center;padding:60px 20px;color:var(--txt3)">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="rgba(170,255,0,.2)" stroke-width="1.5" stroke-linecap="round" style="margin:0 auto 16px;display:block"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          <p style="font-size:15px;font-weight:600;color:var(--txt2);margin-bottom:8px">No APIs connected yet</p>
          <p style="font-size:13px;margin-bottom:20px">Click <strong style="color:var(--c-green)">+ Add API</strong> to connect your first API and start using the AI Playground.</p>
        </div>
        {{/unless}}
      </div>
      {{/if}}

      {{!-- ═══ POLICY BUILDER ═════════════════════════════════════ --}}
      {{#if (eq page 'policy-builder')}}
      <div class="page-header-row">
        <div>
          <h1>Policy Builder</h1>
          <p>Create API access policies — enforced server-side by Latch</p>
        </div>
        <div style="display:flex;align-items:center;gap:8px;font-size:12px;color:var(--txt3)">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#aaff00" stroke-width="2" stroke-linecap="round"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
          <span style="color:var(--c-green);font-weight:600">Latch</span> authorization engine active
        </div>
      </div>

      <!-- 4-step progress bar -->
      <div class="steps-bar" id="steps-bar">
        <div class="step step-active" data-step="1"><span class="step-num">1</span> Write Policy</div>
        <div class="step-line"></div>
        <div class="step" data-step="2"><span class="step-num">2</span> Review Rules</div>
        <div class="step-line"></div>
        <div class="step" data-step="3"><span class="step-num">3</span> Validate</div>
        <div class="step-line"></div>
        <div class="step" data-step="4"><span class="step-num">4</span> Activate</div>
      </div>

      <!-- Step 1: Write -->
      <div class="card" id="policy-write-panel">
        <label class="form-label">Describe your policy in plain language</label>
        <textarea class="policy-ta" id="policy-input" maxlength="500"
          placeholder="Allow Coinbase API to return Bitcoin price only.&#10;Block all other asset requests. Limit to 10 requests per hour."></textarea>
        <div class="ta-footer">
          <span id="policy-error" class="field-error"></span>
          <span class="char-ct" id="char-ct">0/500</span>
        </div>
        <button class="btn-primary btn-full" id="gen-policy-btn" style="margin-top:12px">Generate Policy →</button>
      </div>

      <div class="policy-examples">
        <h4>Example Commands</h4>
        <div class="chips-row">
          <span class="chip" data-text="Allow Bitcoin price from Coinbase only. Block all other crypto assets. Limit to 10 requests per hour.">Bitcoin price only</span>
          <span class="chip" data-text="Block Solana, Ethereum and all non-Bitcoin assets from Coinbase">Block non-BTC assets</span>
          <span class="chip" data-text="Limit SMS to 5 messages per day">SMS 5/day limit</span>
          <span class="chip" data-text="Allow Grok for general chat and Q&A only">Allow Grok chat</span>
          <span class="chip" data-text="Block all trading, withdrawals and fund transfers on Coinbase">Block trading & withdrawals</span>
        </div>
      </div>

      <!-- Step 2: Review (generated policy + Latch tokens) -->
      <div id="policy-result-panel" style="display:none;margin-top:24px">
        <div class="card">
          <div class="card-hdr">
            <span class="card-title">Generated Policy Rules</span>
            <span class="status-pill s-connected" id="policy-validity-badge"><span></span>Ready</span>
          </div>

          <!-- Latch token preview -->
          <div id="latch-tokens-preview" style="margin-bottom:16px;display:none">
            <div style="font-size:11px;font-weight:700;color:var(--txt3);text-transform:uppercase;letter-spacing:.06em;margin-bottom:8px;display:flex;align-items:center;gap:6px">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#aaff00" stroke-width="2.5" stroke-linecap="round"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
              Latch Proxy Tokens (preview)
            </div>
            <div id="latch-tokens-list"></div>
            <div style="font-size:11px;color:var(--txt3);margin-top:6px">
              Real credentials never exposed — agents use <code style="background:rgba(170,255,0,.08);color:#aaff00;padding:1px 5px;border-radius:3px">lat_…</code> proxy tokens issued per request
            </div>
          </div>

          <!-- Rules table -->
          <div id="rules-preview-list" style="margin-bottom:16px"></div>

          <!-- Validation result -->
          <div id="validation-result" style="display:none;margin-bottom:16px"></div>

          <!-- JSON view (collapsible) -->
          <details style="margin-bottom:16px">
            <summary style="font-size:12px;color:var(--txt3);cursor:pointer;padding:8px 0">View raw policy JSON</summary>
            <pre id="policy-json-out" class="policy-json-pre" style="margin-top:8px"></pre>
          </details>

          <!-- Policy name editor -->
          <div class="form-group" style="margin-bottom:16px">
            <label>Policy Name</label>
            <input class="form-input" type="text" id="policy-name-input" placeholder="e.g. Bitcoin Price Policy"/>
          </div>

          <div class="btn-row">
            <button class="btn-outline btn-flex" id="preview-policy-btn">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4-4"/></svg>
              Validate with Latch
            </button>
            <button class="btn-primary btn-flex" id="activate-policy-btn">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              Activate Policy
            </button>
          </div>
        </div>
      </div>

      <!-- Confirm modal -->
      <div id="policy-confirm-overlay" class="modal-overlay" style="display:none">
        <div class="modal">
          <div class="modal-hdr">
            <h3>Confirm Policy Activation</h3>
            <button class="modal-close" id="close-policy-modal">✕</button>
          </div>
          <p style="font-size:13px;color:var(--txt2);margin-bottom:14px">
            This policy will be enforced server-side by the Latch authorization engine immediately after activation.
          </p>
          <div class="modal-policy-preview" id="modal-policy-text" style="background:var(--bg3);border-radius:8px;padding:12px;font-size:13px;color:var(--txt);margin-bottom:16px"></div>
          <div style="display:flex;align-items:center;gap:7px;font-size:12px;color:var(--c-green);margin-bottom:18px">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
            Enforced by Latch — not just a system prompt
          </div>
          <div class="btn-row">
            <button class="btn-outline btn-flex" id="cancel-activate-btn">Cancel</button>
            <button class="btn-primary btn-flex" id="confirm-activate-btn">Confirm & Activate</button>
          </div>
        </div>
      </div>

      <!-- Success banner -->
      <div id="policy-success-banner" class="success-banner" style="display:none">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#aaff00" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        Policy activated and enforced by Latch!
      </div>

      <!-- Active Policies list -->
      <div style="margin-top:32px">
        <div class="section-title-row">
          <span class="section-title">Active Policies</span>
          <span style="font-size:12px;color:var(--txt3)">{{policies.length}} total</span>
        </div>
        <div id="active-policies-list">
          {{#each policies}}
          <div class="api-row" style="margin-bottom:10px" data-policy-id="{{id}}">
            <div style="width:40px;height:40px;border-radius:10px;background:{{#if (eq status 'active')}}var(--c-green-dim){{else}}var(--bg3){{/if}};border:1px solid {{#if (eq status 'active')}}rgba(170,255,0,.3){{else}}var(--bd2){{/if}};display:flex;align-items:center;justify-content:center;flex-shrink:0">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="{{#if (eq status 'active')}}#aaff00{{else}}#555{{/if}}" stroke-width="2" stroke-linecap="round"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
            </div>
            <div class="api-row-info">
              <div class="api-row-cat">{{api}} · Created {{created}}</div>
              <div class="api-row-name">{{name}}</div>
              <div class="api-row-desc" style="max-width:480px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{description}}</div>
            </div>
            <div class="api-row-actions">
              {{#if (eq status 'active')}}
              <span class="status-pill s-connected"><span></span>Active</span>
              <button class="btn-manage policy-toggle-btn" data-id="{{id}}" data-status="active" style="color:#ffcc00;border-color:rgba(255,204,0,.3)">Deactivate</button>
              {{else}}
              <span class="status-pill s-disconnected"><span></span>Inactive</span>
              <button class="btn-manage policy-toggle-btn" data-id="{{id}}" data-status="inactive" style="color:var(--c-green);border-color:rgba(170,255,0,.3)">Activate</button>
              {{/if}}
              <button class="btn-manage policy-delete-btn" data-id="{{id}}" style="color:var(--c-red);border-color:rgba(255,68,68,.3)">Remove</button>
            </div>
          </div>
          {{else}}
          <div style="text-align:center;padding:32px;color:var(--txt3);font-size:13px">No policies yet — create one above.</div>
          {{/each}}
        </div>
      </div>
      {{/if}}

      {{!-- ═══ AI PLAYGROUND ══════════════════════════════════════ --}}
      {{#if (eq page 'ai-playground')}}
      <div class="page-header" style="display:flex;justify-content:space-between;align-items:flex-start">
        <div>
          <h1>AI Playground</h1>
          <p>Chat with your AI, powered by your APIs and policies</p>
        </div>
        <button class="btn-outline" id="new-chat-btn" style="display:flex;align-items:center;gap:6px;font-size:13px">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          New Chat
        </button>
      </div>

      <div class="playground-layout">

        <!-- ── Left: Chat Panel ── -->
        <div class="chat-panel">

          <!-- Top bar -->
          <div class="chat-topbar">
            <div class="chat-selects">
              <div class="custom-select-wrap">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="rgba(170,255,0,.5)" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/></svg>
                <select id="model-select">
                  <option value="carbon">Carbon Agent</option>
                  <option value="grok">Grok (xAI)</option>
                  <option value="gpt4o">GPT-4o</option>
                </select>
              </div>
              <!-- API scope — populated from connected APIs -->
              <div class="custom-select-wrap">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="rgba(170,255,0,.4)" stroke-width="2" stroke-linecap="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                <select id="api-select">
                  <option value="all">All APIs</option>
                  {{#each connectedApis}}
                  <option value="{{name}}">{{name}}</option>
                  {{/each}}
                </select>
              </div>
            </div>
            <div class="system-online">
              <span class="sys-dot"></span>
              <span id="api-scope-label">{{connectedApis.length}} APIs active</span>
            </div>
          </div>

          <!-- Messages -->
          <div class="chat-messages" id="chat-messages">

            <!-- Welcome state (hidden when conversation starts) -->
            <div class="chat-welcome" id="chat-welcome">
              <div class="chat-welcome-icon">
                <img src="/assets/carbon-logo.svg" width="28" height="28" alt="Carbon"/>
              </div>
              <h3>Carbon AI Agent</h3>
              <p>Your AI is connected to your APIs and governed by your active policies. Ask anything or try a suggestion below.</p>
              <div class="welcome-chips" id="welcome-chips">
                <button class="welcome-chip" data-prompt="What APIs are connected?">
                  <span class="welcome-chip-icon">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#aaff00" stroke-width="2" stroke-linecap="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                  </span>
                  What APIs are connected?
                </button>
                <button class="welcome-chip" data-prompt="What can you do?">
                  <span class="welcome-chip-icon">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#aaff00" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4"/></svg>
                  </span>
                  What can you do?
                </button>
                <button class="welcome-chip" data-prompt="What are my active policies?">
                  <span class="welcome-chip-icon">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#aaff00" stroke-width="2" stroke-linecap="round"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                  </span>
                  What are my active policies?
                </button>
              </div>
            </div>

          </div>

          <!-- Suggestions strip -->
          <div class="chat-suggestions" id="chat-suggestions" style="display:none">
            <button class="sug-chip" data-prompt="What APIs are connected?">🔗 My APIs</button>
            <button class="sug-chip" data-prompt="What can you do?">⚡ Capabilities</button>
            <button class="sug-chip" data-prompt="What are my active policies?">🛡 Policies</button>
          </div>

          <!-- Input bar -->
          <div class="chat-input-bar">
            <div class="chat-input-row">
              <textarea
                class="chat-input"
                id="chat-input"
                placeholder="Message Carbon AI…"
                rows="1"
              ></textarea>
              <button class="send-btn" id="send-btn" title="Send (Enter)">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M22 2L11 13M22 2L15 22l-4-9-9-4 20-7z"/></svg>
              </button>
            </div>
            <div class="chat-input-meta">
              <span class="chat-input-hint">Enter to send · Shift+Enter for new line</span>
              <span class="chat-char-ct" id="chat-char-ct">0</span>
            </div>
          </div>

        </div><!-- /chat-panel -->

        <!-- ── Right: Request Details Panel ── -->
        <div class="req-panel" id="req-panel">

          <div class="rp-card" id="req-details-card">
            <div class="rp-title">Last Request</div>
            <div class="rp-row">
              <span class="rp-key">Status</span>
              <span class="rp-val" id="rp-status" style="color:rgba(255,255,255,.2)">—</span>
            </div>
            <div class="rp-row">
              <span class="rp-key">Intent</span>
              <span class="rp-val" id="rp-intent" style="color:rgba(255,255,255,.2)">—</span>
            </div>
            <div class="rp-row">
              <span class="rp-key">Policy</span>
              <span class="rp-val" id="rp-policy" style="color:rgba(255,255,255,.2)">—</span>
            </div>
            <div class="rp-row">
              <span class="rp-key">API</span>
              <span class="rp-val" id="rp-api" style="color:rgba(255,255,255,.2)">—</span>
            </div>
            <div class="rp-row">
              <span class="rp-key">Endpoint</span>
              <span class="rp-val" id="rp-endpoint" style="color:rgba(255,255,255,.2);font-size:10px;font-family:monospace">—</span>
            </div>
            <div class="rp-row">
              <span class="rp-key">Time</span>
              <span class="rp-val" id="rp-time" style="color:rgba(255,255,255,.2)">—</span>
            </div>
          </div>

          <div class="rp-card" id="rules-card">
            <div class="rp-title">Policy Engine</div>
            <div class="rules-list" id="rules-list">
              <div class="rule" style="color:rgba(255,255,255,.2)">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg>
                Waiting for request…
              </div>
            </div>
          </div>

          <div class="rp-card">
            <div class="rp-title">Active Policies</div>
            {{#each policies}}
              {{#if (eq status 'active')}}
              <div style="padding:7px 0;border-bottom:1px solid rgba(255,255,255,.04)">
                <div style="font-size:12px;font-weight:600;color:var(--txt);margin-bottom:3px">{{name}}</div>
                <div style="font-size:10px;color:rgba(170,255,0,.6)">{{api}} · Active</div>
              </div>
              {{/if}}
            {{/each}}
          </div>

        </div><!-- /req-panel -->

      </div>
      {{/if}}

      {{!-- SECURITY PAGE REMOVED --}}

      {{!-- ═══ REQUEST LOGS ════════════════════════════════════════ --}}
      {{#if (eq page 'request-logs')}}
      <div class="page-header-row">
        <div>
          <h1>Request Logs</h1>
          <p>Full log of all API requests</p>
        </div>
        <div class="toolbar" style="margin:0">
          <div class="search-box">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4-4"/></svg>
            <input type="text" placeholder="Search logs..." id="log-search"/>
          </div>
          <select class="filter-select">
            <option>Last 7 days</option>
            <option>Last 30 days</option>
          </select>
        </div>
      </div>

      <div class="filter-bar" style="margin-bottom:16px">
        <div class="filter-pills" id="rl-filters">
          <button class="tab-pill tab-active" data-filter="all">All</button>
          <button class="tab-pill" data-filter="allowed">Allowed</button>
          <button class="tab-pill" data-filter="blocked">Blocked</button>
        </div>
      </div>

      <div class="log-table-wrap card" style="padding:0">
        <div class="log-thead">
          <span>Time</span><span>API</span><span>Result</span><span>Policy</span><span>Details</span>
        </div>
        <div id="rl-tbody">
          {{#each logs}}
          <div class="log-row" data-result="{{result}}">
            <span class="log-time">{{time}}</span>
            <span class="log-api">{{api}}</span>
            <span><span class="result-badge rb-{{result}}">{{result}}</span></span>
            <span class="log-policy">{{policy}}</span>
            <span class="log-detail">{{detail}}</span>
          </div>
          {{/each}}
        </div>
      </div>
      {{/if}}

      {{!-- ═══ SETTINGS ════════════════════════════════════════════ --}}
      {{#if (eq page 'settings')}}
      <div class="page-header">
        <h1>Settings</h1>
        <p>Manage your account and preferences</p>
      </div>

      <div class="settings-layout">
        <aside class="settings-nav-panel">
          <div class="s-nav-item s-nav-active" data-section="profile">Profile</div>
          <div class="s-nav-item" data-section="security-s">Security</div>
        </aside>

        <div class="settings-panels">
          <div class="settings-panel s-panel-active" id="section-profile">
            <div class="card">
              <h3 class="settings-h3">Profile Settings</h3>
              <p class="settings-desc">Update your personal information</p>
              <div class="form-row-2">
                <div class="form-group">
                  <label>Full Name</label>
                  <input class="form-input" type="text" value="{{user.name}}" id="s-name"/>
                </div>
                <div class="form-group">
                  <label>Initials</label>
                  <input class="form-input" type="text" value="{{user.initials}}" id="s-initials" maxlength="2" style="width:80px"/>
                </div>
              </div>
              <div class="form-group">
                <label>Email</label>
                <input class="form-input" type="email" value="{{user.email}}" id="s-email" {{#if supabaseConfigured}}readonly style="opacity:.5;cursor:not-allowed"{{/if}}/>
                {{#if supabaseConfigured}}<small style="font-size:11px;color:var(--txt3)">Email changes must be made through your Supabase account settings.</small>{{/if}}
              </div>
              <button class="btn-primary" id="save-profile-btn">Save Changes</button>
              <div id="profile-saved" class="inline-success" style="display:none">✓ Saved</div>
              <div id="profile-error" class="inline-success" style="display:none;color:var(--c-red)">✗ Save failed</div>
            </div>
          </div>

          <div class="settings-panel" id="section-security-s" style="display:none">
            <div class="card">
              <h3 class="settings-h3">Security</h3>
              <p class="settings-desc">Change your password</p>
              {{#if supabaseConfigured}}
              <div class="form-group">
                <label>New Password</label>
                <input class="form-input" type="password" placeholder="Min 8 characters" id="s-new-password"/>
              </div>
              <div class="form-group">
                <label>Confirm New Password</label>
                <input class="form-input" type="password" placeholder="Repeat new password" id="s-confirm-password"/>
              </div>
              <button class="btn-primary" id="save-password-btn">Update Password</button>
              <div id="password-saved" class="inline-success" style="display:none">✓ Password updated</div>
              <div id="password-error" class="inline-success" style="display:none;color:var(--c-red)">✗ Error</div>
              {{else}}
              <p style="color:var(--txt3);font-size:13px">Connect Supabase to enable password management.</p>
              {{/if}}
            </div>
          </div>

          <!-- Only Profile and Security tabs remain -->
        </div>
      </div>
      {{/if}}

    </div><!-- /page-area -->
  </main>

  <!-- ═══ MODALS ═══════════════════════════════════════════════ -->
  <div id="add-api-overlay" class="modal-overlay" style="display:none">
    <div class="modal">
      <div class="modal-hdr">
        <h3>Add New API</h3>
        <button class="modal-close" id="close-add-api">✕</button>
      </div>
      <div class="form-group">
        <label>API Name <span class="req">*</span></label>
        <input class="form-input" type="text" id="new-api-name" placeholder="e.g. OpenWeather API"/>
        <span class="field-error" id="err-name"></span>
      </div>
      <div class="form-group">
        <label>Category</label>
        <input class="form-input" type="text" id="new-api-cat" placeholder="e.g. Weather API"/>
      </div>
      <div class="form-group">
        <label>Base URL <span class="req">*</span></label>
        <input class="form-input" type="url" id="new-api-url" placeholder="https://api.example.com"/>
        <span class="field-error" id="err-url"></span>
      </div>
      <div class="form-group">
        <label>API Key <span class="req">*</span></label>
        <input class="form-input" type="password" id="new-api-key" placeholder="sk-..."/>
        <span class="field-error" id="err-key"></span>
      </div>
      <div class="btn-row" style="margin-top:20px">
        <button class="btn-outline btn-flex" id="cancel-add-api">Cancel</button>
        <button class="btn-primary btn-flex" id="confirm-add-api">Connect API</button>
      </div>
    </div>
  </div>

  <div id="manage-api-overlay" class="modal-overlay" style="display:none">
    <div class="modal">
      <div class="modal-hdr">
        <h3>Manage: <span id="manage-api-name"></span></h3>
        <button class="modal-close" id="close-manage-api">✕</button>
      </div>

      <!-- API info row -->
      <div id="manage-api-meta" style="display:flex;align-items:center;gap:10px;margin-bottom:18px;padding:12px;background:var(--bg3);border-radius:8px;font-size:12px;color:var(--txt2)">
        <div style="flex:1">
          <div id="manage-api-cat" style="font-size:10px;text-transform:uppercase;letter-spacing:.06em;color:var(--txt3);margin-bottom:2px"></div>
          <div id="manage-api-url" style="font-family:monospace;font-size:11px;color:var(--txt3)"></div>
        </div>
        <span id="manage-api-status-badge" class="status-pill s-connected"><span></span>Connected</span>
      </div>

      <!-- Action buttons -->
      <div class="manage-options">
        <button class="manage-opt" id="test-api-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#aaff00" stroke-width="2" stroke-linecap="round"><polyline points="16 3 21 3 21 8"/><line x1="4" y1="20" x2="21" y2="3"/></svg>
          Test Connection
        </button>
        <button class="manage-opt" id="edit-api-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#aaff00" stroke-width="2" stroke-linecap="round"><path d="M12 20h9M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
          Edit Credentials
        </button>
        <button class="manage-opt" id="toggle-api-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#aaff00" stroke-width="2" stroke-linecap="round"><path d="M18.36 6.64a9 9 0 1 1-12.73 0"/><line x1="12" y1="2" x2="12" y2="12"/></svg>
          <span id="toggle-api-label">Disconnect API</span>
        </button>
        <button class="manage-opt manage-opt-danger" id="disconnect-api-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ff4444" stroke-width="2" stroke-linecap="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6M14 11v6"/></svg>
          Remove API
        </button>
      </div>

      <!-- Test / result feedback -->
      <div id="manage-result" style="display:none;margin-top:14px" class="success-banner"></div>

      <!-- Edit credentials panel (hidden by default) -->
      <div id="edit-creds-panel" style="display:none;margin-top:16px">
        <div class="form-group">
          <label>API Name</label>
          <input class="form-input" type="text" id="edit-api-name-input" placeholder="API Name"/>
        </div>
        <div class="form-group">
          <label>Category</label>
          <input class="form-input" type="text" id="edit-api-cat-input" placeholder="e.g. Weather API"/>
        </div>
        <div class="form-group">
          <label>Base URL</label>
          <input class="form-input" type="url" id="edit-api-url-input" placeholder="https://api.example.com"/>
        </div>
        <div class="form-group">
          <label>New API Key <span style="font-size:10px;color:var(--txt3)">(leave blank to keep current)</span></label>
          <input class="form-input" type="password" id="edit-api-key-input" placeholder="Enter new key to update"/>
        </div>
        <div class="btn-row">
          <button class="btn-outline btn-flex" id="cancel-edit-btn">Cancel</button>
          <button class="btn-primary btn-flex" id="save-edit-btn">Save Changes</button>
        </div>
      </div>

      <!-- Confirm remove panel -->
      <div id="confirm-remove-panel" style="display:none;margin-top:16px;padding:14px;background:rgba(255,68,68,.06);border:1px solid rgba(255,68,68,.2);border-radius:10px">
        <p style="font-size:13px;color:var(--txt);margin-bottom:12px">Remove <strong id="confirm-remove-name"></strong> from your workspace? This cannot be undone.</p>
        <div class="btn-row">
          <button class="btn-outline btn-flex" id="cancel-remove-btn">Cancel</button>
          <button class="btn-primary btn-flex" id="confirm-remove-btn" style="background:var(--c-red);box-shadow:none">Remove</button>
        </div>
      </div>
    </div>
  </div>

  <div id="toast" class="toast" style="display:none"></div>

  <script src="/js/dashboard.js"></script>

  <!-- ── Carbon Auth Client ────────────────────────────────────── -->
  {{#if supabaseConfigured}}
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js"></script>
  <script>
  // Initialize Supabase client for browser-side operations (profile update, password change)
  // The anon key is safe to expose in the browser — it's a public key.
  // Credentials and secrets are never stored here.
  (function initCarbonSupabase() {
    const SUPABASE_URL  = '{{{supabaseUrl}}}';
    const SUPABASE_KEY  = '{{{supabaseAnonKey}}}';
    if (!SUPABASE_URL || !SUPABASE_KEY) return;
    const { createClient } = supabase;
    window.__carbonSb = createClient(SUPABASE_URL, SUPABASE_KEY, {
      auth: { autoRefreshToken: true, persistSession: true, storageKey: 'carbon-auth' }
    });
  })();
  </script>
  {{/if}}
  <script>
  (function() {
    // ── Sign out handler ──────────────────────────────────────────
    async function doSignOut(e) {
      if (e) e.preventDefault();
      try { if (window.__carbonSb) await window.__carbonSb.auth.signOut(); } catch(_) {}
      await fetch('/auth/signout', { method: 'POST' }).catch(() => {});
      window.location.href = '/login';
    }

    // Wire all sign-out buttons
    document.querySelectorAll('.pd-signout, #signout-btn').forEach(btn => {
      btn.addEventListener('click', doSignOut);
    });

    {{#if supabaseConfigured}}
    // ── Session refresh every 50 minutes ─────────────────────────
    // Only redirect to login if NOT already on login page
    // and only after a confirmed 401 (not network errors)
    var _refreshFailed = false;

    function safeRedirectToLogin() {
      if (_refreshFailed) return; // prevent multiple redirects
      _refreshFailed = true;
      window.location.href = '/login';
    }

    setInterval(async function() {
      try {
        const resp = await fetch('/api/auth/refresh', { method: 'POST' });
        if (resp.status === 401) safeRedirectToLogin();
      } catch(_) { /* network error — don't redirect */ }
    }, 50 * 60 * 1000);

    // Initial refresh on load — only redirect if token is truly expired
    // Add a small delay to avoid redirect on first page paint
    setTimeout(function() {
      fetch('/api/auth/refresh', { method: 'POST' })
        .then(r => { if (r.status === 401) safeRedirectToLogin(); })
        .catch(function() { /* network error — ignore */ });
    }, 3000);
    {{/if}}
  })();
  </script>
</body>
</html>
